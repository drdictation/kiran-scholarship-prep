# OpenRouter API Key (Required for live AI evaluations)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# AI Model Configuration (Default: Gemini 2.5 Flash via OpenRouter for blazing speed and cost economy)
OPENROUTER_PRIMARY_MODEL=google/gemini-2.5-flash

# Supabase (Optional - the app has built-in local persistence and works immediately without it)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
